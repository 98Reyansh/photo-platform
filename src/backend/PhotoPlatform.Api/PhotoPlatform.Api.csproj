      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoPlatform.Application\PhotoPlatform.Application.csproj" />
    <ProjectReference Include="..\PhotoPlatform.Infrastructure\PhotoPlatform.Infrastructure.csproj" />
  </ItemGroup>

</Project>
